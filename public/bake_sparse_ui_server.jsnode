// Run: node bake_sparse_ui_server.js
// Then open: http://localhost:3000/bake_sparse_ui.html
//
// Deps: npm i express matter-js

const express = require("express");
const path = require("path");
const fs = require("fs");
const Matter = require("matter-js");

const app = express();
app.use(express.json());
app.use(express.static(__dirname));                 // serves HTML, player, and /bakes

const SSE = new Map(); // taskId -> Set(res)

function send(taskId, event, payload) {
  const set = SSE.get(taskId);
  if (!set) return;
  const line = `event: ${event}\ndata: ${JSON.stringify(payload)}\n\n`;
  for (const res of set) res.write(line);
}

// --- shape helpers (same as baker) ---
function widthAtY(y, opts) {
  const { neck, bulb, H, k } = opts;
  const t = Math.min(1, Math.abs(y) / H);
  return neck + (bulb - neck) * Math.pow(t, k);
}

function buildWalls(world, opts) {
  const { Bodies, World } = Matter;
  const parts = [];
  const thick = 8;
  for (let y = -opts.H; y < opts.H; y += opts.slat) {
    const y0 = y, y1 = Math.min(opts.H, y + opts.slat);
    const w0 = widthAtY(y0, opts), w1 = widthAtY(y1, opts);
    const add = (x0, y0, x1, y1) => {
      const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
      const len = Math.hypot(x1 - x0, y1 - y0);
      const ang = Math.atan2(y1 - y0, x1 - x0);
      parts.push(Bodies.rectangle(cx, cy, thick, len + 1, {
        isStatic: true, angle: ang, friction: 0.08, frictionStatic: 0.02, restitution: 0
      }));
    };
    add(-w0, y0, -w1, y1);
    add(+w0, y0, +w1, y1);
  }
  parts.push(Bodies.rectangle(0, -opts.H - 8, opts.bulb * 2 + 40, 16, { isStatic: true }));
  parts.push(Bodies.rectangle(0,  opts.H + 8, opts.bulb * 2 + 40, 16, { isStatic: true }));
  World.add(world, parts);
}

// --- SPARSE BAKER (streamed .bin + tiny .json meta) ---
async function bakeSparse(taskId, rawOpts) {
  // defaults + clamps
  const opt = {
    duration: +rawOpts.duration || 60,
    fps: +rawOpts.fps || 30,
    grains: Math.max(200, +rawOpts.grains || 3500),
    full: Math.min(1, Math.max(0.5, +rawOpts.full || 0.92)),
    neck: Math.max(6, +rawOpts.neck || 16),
    H: +rawOpts.H || 330,
    bulb: +rawOpts.bulb || 205,
    r: +rawOpts.r || 2.6,
    k: +rawOpts.k || 1.05,
    tiltDeg: +rawOpts.tiltDeg || 1.2,
    slat: Math.max(2, +rawOpts.slat || 4),
    flushMaxSec: Math.max(0, +rawOpts.flushMaxSec || 20),
    settleSec: Math.max(0.2, +rawOpts.settleSec || 1.5),
    settleSpeed: Math.max(0.002, +rawOpts.settleSpeed || 0.02),
  };
  opt.grains = Math.round(opt.grains * opt.full);

  const Q = 32;
  const outDir = path.join(__dirname, "bakes");
  fs.mkdirSync(outDir, { recursive: true });
  const base = `hourglass_${opt.duration}s_neck${opt.neck}_k${opt.k}_full${opt.full}_sparse`;
  const binRel = `bakes/${base}.bin`;
  const jsonRel = `bakes/${base}.json`;
  const binAbs = path.join(__dirname, binRel);
  const jsonAbs = path.join(__dirname, jsonRel);
  const ws = fs.createWriteStream(binAbs);

  // let the UI know what we’re doing
  send(taskId, "meta", { opts: opt });

  // Matter world
  const { Engine, World, Bodies, Body } = Matter;
  const engine = Engine.create();
  const world = engine.world;

  const th = opt.tiltDeg * Math.PI / 180;
  world.gravity.x = Math.sin(th);
  world.gravity.y = Math.cos(th);
  world.gravity.scale = 0.0018;

  buildWalls(world, opt);

  // Sand (top only)
  const sand = [];
  for (let i = 0; i < opt.grains; i++) {
    const yy = -opt.H + 12 + Math.random() * (opt.H * 0.82);
    const w = widthAtY(yy, opt) - 2;
    const xx = (Math.random() * 2 - 1) * w * 0.74;
    sand.push(Bodies.circle(xx, yy, opt.r, {
      friction: 0.05, frictionStatic: 0.02, frictionAir: 0.001,
      restitution: 0.05, density: 0.001
    }));
  }
  World.add(world, sand);

  // timing
  const physHz = 240;
  const dtMs = 1000 / physHz;
  const sampleEvery = Math.max(1, Math.round(physHz / opt.fps));
  const targetFrames = Math.ceil(opt.duration * opt.fps);
  const settleTicks = Math.max(1, Math.round(opt.settleSec * physHz));

  // sparse state
  const lastXQ = new Uint16Array(opt.grains);
  const lastYQ = new Uint16Array(opt.grains);
  const stillCount = new Uint16Array(opt.grains);
  const settled = new Uint8Array(opt.grains);

  const writeU16 = v => { const b = Buffer.allocUnsafe(2); b.writeUInt16LE(v, 0); ws.write(b); };

  // frame 0: write all
  for (let i = 0; i < opt.grains; i++) {
    const b = sand[i];
    const xq = Math.max(0, Math.min(65535, Math.round((b.position.x + opt.bulb + 5) * Q)));
    const yq = Math.max(0, Math.min(65535, Math.round((b.position.y + opt.H   + 5) * Q)));
    lastXQ[i] = xq; lastYQ[i] = yq;
    writeU16(xq); writeU16(yq);
  }

  let frame = 1, tick = 0, extra = 0;
  const maxExtraFrames = Math.round(opt.flushMaxSec * opt.fps);

  const jiggle = () => {
    const prog = frame / Math.max(1, targetFrames);
    const amp = prog > 0.85 ? 2.0 : 1.0;
    for (const b of sand) {
      if (Math.abs(b.position.y) < 26) {
        Body.applyForce(b, b.position, { x: (Math.random() - 0.5) * 1e-5 * amp, y: 0 });
      }
    }
  };

  const anyTop = () => sand.some((b, i) => !settled[i] && b.position.y < 0);

  function dumpSparseFrame() {
    const upd = [];
    for (let i = 0; i < opt.grains; i++) {
      if (settled[i]) continue;

      const v = sand[i].velocity;
      const speed = Math.hypot(v.x, v.y);
      if (sand[i].position.y > opt.r * 2 && speed < opt.settleSpeed) {
        if (++stillCount[i] >= settleTicks) {
          settled[i] = 1;
          const xq = Math.max(0, Math.min(65535, Math.round((sand[i].position.x + opt.bulb + 5) * Q)));
          const yq = Math.max(0, Math.min(65535, Math.round((sand[i].position.y + opt.H   + 5) * Q)));
          if (xq !== lastXQ[i] || yq !== lastYQ[i]) {
            lastXQ[i] = xq; lastYQ[i] = yq; upd.push(i, xq, yq);
          }
          continue;
        }
      } else {
        stillCount[i] = 0;
      }

      const xq = Math.max(0, Math.min(65535, Math.round((sand[i].position.x + opt.bulb + 5) * Q)));
      const yq = Math.max(0, Math.min(65535, Math.round((sand[i].position.y + opt.H   + 5) * Q)));
      if (xq !== lastXQ[i] || yq !== lastYQ[i]) {
        lastXQ[i] = xq; lastYQ[i] = yq; upd.push(i, xq, yq);
      }
    }

    writeU16(upd.length / 3);
    const buf = Buffer.allocUnsafe(upd.length * 2);
    for (let j = 0; j < upd.length; j++) buf.writeUInt16LE(upd[j], j * 2);
    ws.write(buf);
  }

  const report = (stage) => {
    const bytesMB = ws.bytesWritten / 1e6;
    send(taskId, "progress", {
      stage,
      frame, targetFrames, extra,
      bytesMB: +bytesMB.toFixed(2),
      settled: settled.reduce((a, b) => a + (b ? 1 : 0), 0)
    });
  };

  // main
  report("start");
  while (frame <= targetFrames) {
    jiggle();
    Matter.Engine.update(engine, dtMs);
    tick++;
    if (tick % sampleEvery === 0) {
      dumpSparseFrame(); frame++;
      if (frame % 30 === 0) report("baking");
    }
  }

  // flush top bulb
  while (anyTop() && extra < maxExtraFrames) {
    jiggle();
    Matter.Engine.update(engine, dtMs);
    tick++;
    if (tick % sampleEvery === 0) {
      dumpSparseFrame(); frame++; extra++;
      if (extra % 10 === 0) report("flushing");
    }
  }

  await new Promise((r) => ws.end(r));

  const frames = frame;
  const retimeFps = frames / opt.duration;
  const meta = {
    version: 4,
    format: "sparse",
    fps: retimeFps,
    grains: opt.grains,
    frames,
    Q,
    neck: opt.neck,
    H: opt.H,
    bulb: opt.bulb,
    r: opt.r,
    k: opt.k,
    bin: `${base}.bin`
  };
  fs.writeFileSync(jsonAbs, JSON.stringify(meta, null, 2));
  report("done");
  send(taskId, "done", { meta: jsonRel, bin: binRel, fps: retimeFps });
}

// --- REST/SSE endpoints ---

app.post("/api/bake", (req, res) => {
  const taskId = Date.now().toString(36);
  res.json({ taskId });                          // client opens SSE right after this
  bakeSparse(taskId, req.body).catch(err => {
    console.error(err);
    send(taskId, "error", { message: String(err) });
  });
});

app.get("/api/progress/:id", (req, res) => {
  res.setHeader("Content-Type", "text/event-stream");
  res.setHeader("Cache-Control", "no-cache");
  res.setHeader("Connection", "keep-alive");
  res.flushHeaders();
  res.write(":\n\n"); // ping
  const id = req.params.id;
  if (!SSE.has(id)) SSE.set(id, new Set());
  SSE.get(id).add(res);
  req.on("close", () => {
    const set = SSE.get(id);
    if (set) { set.delete(res); if (!set.size) SSE.delete(id); }
  });
});

// list baked metas
app.get("/api/bakes", (req, res) => {
  const dir = path.join(__dirname, "bakes");
  if (!fs.existsSync(dir)) return res.json([]);
  const files = fs.readdirSync(dir).filter(f => f.endsWith(".json"));
  res.json(files.map(f => `bakes/${f}`));
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log("Bake UI ready: http://localhost:" + PORT + "/bake_sparse_ui.html"));
